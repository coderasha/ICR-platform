# PostgreSQL
POSTGRES_DB=icr_platform
POSTGRES_USER=icr_app
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_HOST_PORT=5433

# Redis
REDIS_PASSWORD=replace_with_a_different_strong_local_password
REDIS_HOST_PORT=6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=icr_minio_admin
MINIO_ROOT_PASSWORD=replace_with_a_strong_minio_password
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_BUCKET=icr-platform-local
JWT_ACCESS_SECRET=
JWT_ACCESS_TOKEN_TTL=900

# Web application origin used by credentialed API CORS in local development.
WEB_ORIGIN=http://localhost:3000
