# PostgreSQL
POSTGRES_DB=icr_platform
POSTGRES_USER=icr_app
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_HOST_PORT=5433

# Redis
REDIS_PASSWORD=replace_with_a_different_strong_local_password
REDIS_HOST_PORT=6379

# Local S3-compatible test storage
# Variable names are retained for compatibility with existing local .env files.
MINIO_ROOT_USER=icr_minio_admin
MINIO_ROOT_PASSWORD=replace_with_a_strong_minio_password
MINIO_API_HOST_PORT=9000
MINIO_BUCKET=icr-platform-local
# Storage defaults to local files during development. For S3-compatible storage, set these
# explicitly; production requires STORAGE_DRIVER=s3 and every S3_* credential.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/tmp/icr-storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=icr-platform-local
S3_ACCESS_KEY_ID=icr_minio_admin
S3_SECRET_ACCESS_KEY=replace_with_a_strong_minio_password
S3_FORCE_PATH_STYLE=true
JWT_ACCESS_SECRET=
JWT_ACCESS_TOKEN_TTL=900

# Web application origin used by credentialed API CORS in local development.
WEB_ORIGIN=http://localhost:3000
